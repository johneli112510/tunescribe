{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tunescribe",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",

  // Static front end (public/) + the Worker handles /api/*
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // R2 bucket for audio files and saved transcriptions.
  // Create it once:  npx wrangler r2 bucket create tunescribe-files
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "tunescribe-files" }
  ],

  "observability": { "enabled": true }

  // Optional password for the whole app (set as a secret, not here):
  //   npx wrangler secret put APP_PASSWORD
}
